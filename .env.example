GEMINI_API_KEY=your_gemini_api_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
# Optional schema of website_leads (lib/lead-target.js): unset = public, as today; itp_hub only with the Core URL/key.
VITE_SUPABASE_DB_SCHEMA=
# Server-only public keys for school mode. The showcase RPC lives in Warubi Core.
MYSEASON_SUPABASE_URL=https://your-myseason-project.supabase.co
MYSEASON_SUPABASE_ANON_KEY=your_myseason_anon_key
WARUBI_CORE_SUPABASE_URL=https://your-core-project.supabase.co
WARUBI_CORE_SUPABASE_ANON_KEY=your_core_anon_key
# Scout referral service target. Leave schema and pause unset before the ITP move.
SCOUT_SUPABASE_URL=https://umblyhwumtadlvgccdwg.supabase.co
SCOUT_SUPABASE_SERVICE_KEY=your_scout_service_key
# At cutover: set URL to https://wwomwawpxmkrykybpqok.supabase.co, use its service
# key, and set SCOUT_SUPABASE_DB_SCHEMA=itp together. No automatic fallback.
SCOUT_SUPABASE_DB_SCHEMA=
# Exactly true (trimmed) refuses valid referral analyses with 503 before Gemini.
ITP_REFERRAL_PAUSED=
